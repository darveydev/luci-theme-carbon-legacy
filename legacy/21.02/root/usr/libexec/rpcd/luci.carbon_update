#!/bin/sh
# Carbon theme settings backend for the Legacy (Lua LuCI / OpenWrt 21.02) port.
#
# The modern ucode package ships the full backend with release checking,
# verified upgrades and the custom-logo uploader. None of that applies to the
# Legacy port (no updater UI, no logo uploader), so this is a trimmed variant
# that only keeps what the Legacy dashboard and sidebar actually call:
#
#   set_dashboard   persist the dashboard layout in `carbon.dashboard`
#   set_simple_menu persist the sidebar menu mode in `carbon.simple_menu`
#
# Both validators are kept byte-compatible with the modern backend so a layout
# saved on one port still validates on the other.
#
# Without this file the rpcd object `luci.carbon_update` does not exist, and
# every "save" click fails with -32002 Access denied — which the theme
# surfaces as "Permission denied. Log out and log in again ...".

. /usr/share/libubox/jshn.sh
umask 077

error_reply() { json_init; json_add_string error "$1"; json_dump; }

dash_chars_ok() {
	case "$1" in *'
'*) return 1 ;; esac
	[ "${#1}" -gt 0 ] && [ "${#1}" -le 256 ] && printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9._:@ -]+$'
}

dash_has_tok() {
	case " $1 " in *" $2 "*) return 0 ;; *) return 1 ;; esac
}

menu_chars_ok() {
	case "$1" in *'
'*) return 1 ;; esac
	[ "${#1}" -gt 0 ] && [ "${#1}" -le 1024 ] && printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9._/ -]+$'
}

menu_path_ok() {
	case "$1" in none|logout|logout/*|*..*) return 1 ;; esac
	printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9_-][A-Za-z0-9._-]{0,63}(/[A-Za-z0-9_-][A-Za-z0-9._-]{0,63})?$'
}

set_dashboard() {
	action=''; hero=''; sections=''; monitor=''; tiles=''; details=''
	json_load "$input" 2>/dev/null || { error_reply invalid_dashboard; return; }
	json_get_var action action
	[ -n "$action" ] || action=set
	case "$action" in
		reset)
			uci -q delete carbon.dashboard || :
			[ ! -f /etc/config/carbon ] || uci commit carbon || { error_reply state; return; }
			json_init; json_add_boolean dashboard_custom 0; json_dump
			return
			;;
		set) ;;
		*) error_reply invalid_dashboard; return ;;
	esac
	json_get_var hero hero
	json_get_var sections sections
	json_get_var monitor monitor
	json_get_var tiles tiles
	json_get_var details details
	case "$hero" in 0|1) ;; *) error_reply invalid_dashboard; return ;; esac
	dash_chars_ok "$sections" && dash_chars_ok "$monitor" && dash_chars_ok "$tiles" && dash_chars_ok "$details" || { error_reply invalid_dashboard; return; }

	# sections: exact 3-token permutation of monitor, tiles, details
	sec_norm=''; sec_cnt=0
	for tok in $sections; do
		case "$tok" in
			monitor|tiles|details) ;;
			*) error_reply invalid_dashboard; return ;;
		esac
		dash_has_tok "$sec_norm" "$tok" && { error_reply invalid_dashboard; return; }
		sec_norm="${sec_norm:+$sec_norm }$tok"
		sec_cnt=$((sec_cnt + 1))
	done
	[ "$sec_cnt" = 3 ] || { error_reply invalid_dashboard; return; }

	# monitor: none OR up to 4 traffic:<dev> and at most 1 resources
	mon_norm=''; mon_cnt=0; t_cnt=0; r_cnt=0
	if [ "$monitor" = none ]; then
		mon_norm=none
	else
		for tok in $monitor; do
			case "$tok" in
				resources)
					[ "$r_cnt" = 0 ] || { error_reply invalid_dashboard; return; }
					r_cnt=1
					;;
				traffic:*)
					dev=${tok#traffic:}
					[ "$t_cnt" -lt 4 ] && [ "${#dev}" -ge 1 ] && [ "${#dev}" -le 32 ] &&
					printf '%s\n' "$dev" | grep -Eq '^[A-Za-z0-9._:@-]+$' || { error_reply invalid_dashboard; return; }
					t_cnt=$((t_cnt + 1))
					;;
				*) error_reply invalid_dashboard; return ;;
			esac
			mon_norm="${mon_norm:+$mon_norm }$tok"
			mon_cnt=$((mon_cnt + 1))
		done
		[ "$mon_cnt" -gt 0 ] || { error_reply invalid_dashboard; return; }
	fi

	# tiles: none OR unique subset of built-in tiles
	tile_norm=''; tile_cnt=0
	if [ "$tiles" = none ]; then
		tile_norm=none
	else
		for tok in $tiles; do
			case "$tok" in
				devices|connections|load|uptime|wifi|temp) ;;
				*) error_reply invalid_dashboard; return ;;
			esac
			dash_has_tok "$tile_norm" "$tok" && { error_reply invalid_dashboard; return; }
			tile_norm="${tile_norm:+$tile_norm }$tok"
			tile_cnt=$((tile_cnt + 1))
		done
		[ "$tile_cnt" -gt 0 ] || { error_reply invalid_dashboard; return; }
	fi

	# details: none OR unique subset of built-in detail cards
	det_norm=''; det_cnt=0
	if [ "$details" = none ]; then
		det_norm=none
	else
		for tok in $details; do
			case "$tok" in
				clients|wireless|interfaces) ;;
				*) error_reply invalid_dashboard; return ;;
			esac
			dash_has_tok "$det_norm" "$tok" && { error_reply invalid_dashboard; return; }
			det_norm="${det_norm:+$det_norm }$tok"
			det_cnt=$((det_cnt + 1))
		done
		[ "$det_cnt" -gt 0 ] || { error_reply invalid_dashboard; return; }
	fi

	[ $((hero + mon_cnt + tile_cnt + det_cnt)) -ge 1 ] || { error_reply invalid_dashboard; return; }
	[ -f /etc/config/carbon ] || touch /etc/config/carbon || { error_reply state; return; }
	uci set carbon.dashboard=dashboard &&
	uci set "carbon.dashboard.hero=$hero" &&
	uci set "carbon.dashboard.sections=$sec_norm" &&
	uci set "carbon.dashboard.monitor=$mon_norm" &&
	uci set "carbon.dashboard.tiles=$tile_norm" &&
	uci set "carbon.dashboard.details=$det_norm" &&
	uci commit carbon || { error_reply state; return; }
	json_init
	json_add_boolean dashboard_custom 1
	json_add_string hero "$hero"
	json_add_string sections "$sec_norm"
	json_add_string monitor "$mon_norm"
	json_add_string tiles "$tile_norm"
	json_add_string details "$det_norm"
	json_dump
}

set_simple_menu() {
	action=''; common=''; system=''
	json_load "$input" 2>/dev/null || { error_reply invalid_simple_menu; return; }
	json_get_var action action
	[ -n "$action" ] || action=set
	case "$action" in
		reset)
			uci -q delete carbon.simple_menu || :
			[ ! -f /etc/config/carbon ] || uci commit carbon || { error_reply state; return; }
			json_init; json_add_boolean simple_menu_custom 0; json_dump
			return
			;;
		set) ;;
		*) error_reply invalid_simple_menu; return ;;
	esac
	json_get_var common common
	json_get_var system system
	menu_chars_ok "$common" && menu_chars_ok "$system" || { error_reply invalid_simple_menu; return; }

	all_seen=''; total_cnt=0
	com_norm=''; com_cnt=0
	if [ "$common" = none ]; then
		com_norm=none
	else
		for tok in $common; do
			menu_path_ok "$tok" || { error_reply invalid_simple_menu; return; }
			dash_has_tok "$all_seen" "$tok" && { error_reply invalid_simple_menu; return; }
			all_seen="${all_seen:+$all_seen }$tok"
			com_norm="${com_norm:+$com_norm }$tok"
			com_cnt=$((com_cnt + 1))
			total_cnt=$((total_cnt + 1))
			[ "$total_cnt" -le 32 ] || { error_reply invalid_simple_menu; return; }
		done
		[ "$com_cnt" -gt 0 ] || { error_reply invalid_simple_menu; return; }
	fi

	sys_norm=''; sys_cnt=0
	if [ "$system" = none ]; then
		sys_norm=none
	else
		for tok in $system; do
			menu_path_ok "$tok" || { error_reply invalid_simple_menu; return; }
			dash_has_tok "$all_seen" "$tok" && { error_reply invalid_simple_menu; return; }
			all_seen="${all_seen:+$all_seen }$tok"
			sys_norm="${sys_norm:+$sys_norm }$tok"
			sys_cnt=$((sys_cnt + 1))
			total_cnt=$((total_cnt + 1))
			[ "$total_cnt" -le 32 ] || { error_reply invalid_simple_menu; return; }
		done
		[ "$sys_cnt" -gt 0 ] || { error_reply invalid_simple_menu; return; }
	fi

	[ "$total_cnt" -ge 1 ] || { error_reply invalid_simple_menu; return; }
	[ -f /etc/config/carbon ] || touch /etc/config/carbon || { error_reply state; return; }
	uci set carbon.simple_menu=simple_menu &&
	uci set "carbon.simple_menu.common=$com_norm" &&
	uci set "carbon.simple_menu.system=$sys_norm" &&
	uci commit carbon || { error_reply state; return; }
	json_init
	json_add_boolean simple_menu_custom 1
	json_add_string common "$com_norm"
	json_add_string system "$sys_norm"
	json_dump
}

case "$1" in
	list) printf '%s\n' '{"set_dashboard":{"action":"","hero":"","sections":"","monitor":"","tiles":"","details":""},"set_simple_menu":{"action":"","common":"","system":""}}' ;;
	call)
		input=$(cat)
		case "$2" in
			set_dashboard) set_dashboard ;;
			set_simple_menu) set_simple_menu ;;
			*) error_reply invalid ;;
		esac
		;;
	*) exit 1 ;;
esac
